{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Project",
            "type": "shell",
            "windows": {
                "command": ".\\build.bat"
            },
            "linux": {
                "command": "./build.sh"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$msCompile",
                "$gcc"
            ],
            "detail": "Executes the platform-specific build script (build.bat or build.sh)."
        }
    ]
}
